<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: IDLE"
            android:textColor="@color/secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCurrentTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tidak ada tugas aktif"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvMonitoring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitoring: siap"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Counts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:background="@color/surface_elevated"
                android:padding="10dp" android:layout_margin="3dp">
                <TextView android:id="@+id/tvPendingCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pending" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:background="@color/surface_elevated"
                android:padding="10dp" android:layout_margin="3dp">
                <TextView android:id="@+id/tvInProgressCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Proses" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:background="@color/surface_elevated"
                android:padding="10dp" android:layout_margin="3dp">
                <TextView android:id="@+id/tvCompletedCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/status_running" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Selesai" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:background="@color/surface_elevated"
                android:padding="10dp" android:layout_margin="3dp">
                <TextView android:id="@+id/tvFailedCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/status_stopped" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gagal" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick add task -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tambah Tugas Cepat (dari PR.SOCIAL)"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:textStyle="bold" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Username target (tanpa @) atau link"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:inputType="text" android:backgroundTint="@color/primary"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etReward"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Reward (opsional, contoh 0.0021)"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:inputType="text" android:backgroundTint="@color/primary"
            android:padding="12dp" android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFollow"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="+ FOLLOW"
                android:layout_marginEnd="4dp" app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddLike"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="+ LIKE"
                android:layout_marginStart="4dp" app:cornerRadius="10dp"
                app:strokeColor="@color/primary" android:textColor="@color/primary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartQueue"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="▶ START ANTREAN"
            android:layout_marginTop="12dp" app:cornerRadius="12dp"
            android:backgroundTint="@color/status_running" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenPr"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Buka PR.SOCIAL"
            android:layout_marginTop="8dp" app:cornerRadius="12dp"
            app:strokeColor="@color/secondary" android:textColor="@color/secondary" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Cara pakai cepat:\n1. Buka PR.SOCIAL → salin username target\n2. Tempel di atas → tekan + FOLLOW atau + LIKE\n3. START ANTREAN atau pakai Floating Bubble\n4. Bubble → BUKA TARGET → tekan Ikuti di Instagram → SELESAI"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
